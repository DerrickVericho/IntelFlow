# Sectors
SECTORS_API_KEY=

# Application
LOG_LEVEL=INFO

# Redis exposed by compose.yaml to the host backend process.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=intelflow:sectors:v1
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Cache TTLs
CACHE_TTL_MARKET_CURRENT_SECONDS=3600
CACHE_TTL_MARKET_HISTORICAL_SECONDS=2592000
CACHE_TTL_SHAREHOLDERS_SECONDS=259200
CACHE_TTL_FREE_FLOAT_SECONDS=604800
CACHE_TTL_COMPANY_DYNAMIC_SECONDS=43200
CACHE_TTL_COMPANY_STATIC_SECONDS=604800
CACHE_TTL_REVENUE_SEGMENTS_SECONDS=604800

